#!/bin/bash
# BOTH metric halves for one generation run directory.
#
#   OUT=/scratch/project_2001912/stm-eval/gen_test_1000x5 sbatch metric_evaluation/score_run.sbatch
#   OUT=... NO_MOSES=1 sbatch metric_evaluation/score_run.sbatch     # stability half only, fast
#
# A SEPARATE JOB from generation, on purpose. Scoring is RDKit and multiprocessing; running it
# inside the generation job held a GH200 idle for hours and got job 1176643 cancelled -- see
# score_cpu.sbatch, which this is the two-half successor to.
#
# It still asks for ONE GPU, not four: MOSES threads `device` into
# compute_intermediate_statistics and internal_diversity (evaluation/mose_metric.py:69-70, :114),
# so FCD embeds every molecule through ChemNet, a torch network. Everything else is CPU, which
# is why the CPU count is high and the GPU count is one.
#
# The two halves answer different questions and neither replaces the other:
#
#   paper_metrics.py   SIMILARITY TO THE TARGET -- top-k, Tanimoto, MCES, Fraggle, functional
#                      group. Already parallel (fork Pool + copy-on-write _SHARED).
#   eval_cond.py       THE SAMPLE DISTRIBUTION -- FCD, SNN, Frag, Scaf, IntDiv -- plus
#                      stability, validity, novelty. Its stability loops are now parallel too.
#
# --ks 1 3 5, NEVER 10: these runs generate 5 samples per target, and paper_metrics refuses a k
# above --n-samples rather than reporting a top-10 computed from 5 candidates.
#
# IGNORE Metric-3D in the output. Measured on 500 GROUND-TRUTH structures (job 1228484) it
# reports mol_stable 0.250 where Metric-2D reports 0.974 -- its ceiling on this corpus is 0.25,
# not 1.0, because its bond margins are QM9-tuned and its valence table is charge-blind.
# Metric-2D is the authoritative one. eval_cond prints this caveat next to every 3D line.
#
# SCALE WARNING for the full split: SNN is generated x reference Tanimoto, so 115615 x 23123 is
# ~2.7e9 pairs. It is batched on GPU inside moses, but it is the one metric whose cost is
# quadratic in run size. Run with NO_MOSES=1 first to bank the stability half, then re-run.

#SBATCH --job-name=stm-score-run
#SBATCH --account=project_2001912
#SBATCH --partition=gpumedium
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:gh200:1
#SBATCH --cpus-per-task=64
#SBATCH --time=06:00:00
#SBATCH --output=slurm/logs/%x-%j.out
#SBATCH --error=slurm/logs/%x-%j.out

set -uo pipefail          # NOT -e: the second half must run even if the first fails
mkdir -p slurm/logs

module load python-pytorch/2.10
export PYTHONPATH="$HOME/.cache/ters-overlay:$SLURM_SUBMIT_DIR"
cd "$SLURM_SUBMIT_DIR"

# Workers are separate processes; letting BLAS/OMP thread inside them oversubscribes the node
# and makes it slower, not faster (same reasoning as score_cpu.sbatch).
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

OUT=${OUT:?set OUT to a generation run directory, e.g. .../gen_test_1000x5}
SPLIT=${SPLIT:-test}
CFGQ=${CFGQ:-configs/base_stm.py}
KS=${KS:-1 3 5}
WORKERS=${WORKERS:-$SLURM_CPUS_PER_TASK}
MOLS="$OUT/mols_${SPLIT}.pkl"
PROC="$OUT/processed_${SPLIT}.pkl"

echo "=== $SLURM_JOB_NAME ($SLURM_JOB_ID) on $SLURM_JOB_NODELIST @ $(date -Is) ==="
echo "run dir : $OUT"
echo "workers : $WORKERS (stability), ${MOSES_JOBS:-8} (moses)   ks: $KS   moses: ${NO_MOSES:+off}${NO_MOSES:-on}"
[ -s "$MOLS" ] || { echo "MISSING $MOLS"; exit 1; }
[ -s "$PROC" ] || { echo "MISSING $PROC -- generated by tools/sample_cond.py"; exit 1; }

echo
echo "################ 1. SIMILARITY: top-k, Tanimoto, MCES, Fraggle ################"
# shellcheck disable=SC2086   # KS is a deliberate word-split list
srun python3 tools/paper_metrics.py \
    --cells "stm_${SPLIT}=$MOLS" \
    --ks $KS \
    --workers "$WORKERS" \
    --out "$OUT/metrics_similarity.csv" 2>&1 | tee "$OUT/metrics_similarity.txt"

echo
echo "################ 2. DISTRIBUTION: FCD/SNN/Frag/Scaf/IntDiv + stability ################"
# --n-jobs (MOSES pool) is deliberately MUCH smaller than --workers (stability pool).
# Job 1235060 OOMed at 217 GB with both at 64: get_moses_metrics forks its pool while the
# reference sets are resident, so each worker inherits them, and MOSES workers hold RDKit Mol
# objects rather than the cheap tensor tuples the stability workers touch. The stability loops
# are the ones that actually need the parallelism (115615 molecules of O(n^2) Python each);
# MOSES's own cost is dominated by ChemNet on the GPU, which does not care about the fork count.
srun python3 tools/eval_cond.py \
    --samples "$PROC" \
    --config-qm9 "$CFGQ" \
    --workers "$WORKERS" \
    --n-jobs "${MOSES_JOBS:-8}" \
    ${NO_MOSES:+--no-moses} \
    --out "$OUT/metrics_distribution.json" 2>&1 | tee "$OUT/metrics_distribution.txt"

echo
echo "=== outputs ==="; ls -la "$OUT"/metrics_* 2>/dev/null
echo "=== finished @ $(date -Is) ==="
